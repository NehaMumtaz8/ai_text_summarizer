# Copy this file to ".env" (note the leading dot) in the same folder as app.py.
# python-dotenv only auto-loads a file literally named ".env".
#
# NOTE: MongoDB has been removed from this project. User accounts and history
# now live in the browser's Local Storage (see static/js/storage.js) — no
# database connection string is needed anymore.

# Not currently required by any route, but harmless to keep set.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key

# NOTE: the /chat endpoint no longer uses Gemini or any external AI API.
# It answers from a local predefined Q&A knowledge base (see
# chatbot_qa.py), so no GEMINI_API_KEY or any other API key is needed.

# NOT currently used by app.py (Google OAuth login was removed from this version).
# Safe to leave blank or omit.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
